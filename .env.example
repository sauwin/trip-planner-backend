# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/trip_planner

# Optional - defaults to 3000.
PORT=3000

# Optional - defaults to http://localhost:5173.
FRONTEND_URL=http://localhost:5173

# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string

# (e.g. "15m", "7d").
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_username
SMTP_PASS=replace_with_smtp_password
SMTP_FROM="TripPlanner <no-reply@tripplanner.local>"

# Optional - defaults to 30. Password reset link lifetime, in minutes.
PASSWORD_RESET_EXPIRES_MIN=30
