generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  country      String?
  ageRange     String?
  createdAt    DateTime @default(now())

  interactions  Interaction[]
  trips         Trip[]
  refreshTokens RefreshToken[]

  preferences UserPreference[]
}

model Destination {
  id              String   @id @default(uuid())
  slug            String   @unique
  country         String
  latitude        Float
  longitude       Float
  translations    Json
  popularityScore Float    @default(0)
  createdAt       DateTime @default(now())

  features         DestinationFeature[]
  interactions     Interaction[]
  tripDestinations TripDestination[]
  pointsOfInterest PointOfInterest[]
}

enum PoiCategory {
  ATTRACTION
  MUSEUM
  VIEWPOINT
  RESTAURANT
  CAFE
  PARK
  HOTEL
  OTHER
}

model PointOfInterest {
  id            String      @id @default(uuid())
  destinationId String
  name          String
  category      PoiCategory
  latitude      Float
  longitude     Float
  createdAt     DateTime    @default(now())

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
}

model FeatureCategory {
  id            String @id @default(uuid())
  key           String @unique
  defaultWeight Float  @default(1.0)

  features Feature[]

  userPreferences UserPreference[]
}

model Feature {
  id         String @id @default(uuid())
  key        String @unique
  categoryId String

  category     FeatureCategory      @relation(fields: [categoryId], references: [id])
  destinations DestinationFeature[]

  userPreferences UserPreference[]
}

model DestinationFeature {
  destinationId String
  featureId     String
  weight        Float  @default(1.0)

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  feature     Feature     @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([destinationId, featureId])
  @@index([featureId])
}

enum InteractionType {
  VIEW
  LIKE
  RATING
  SAVE
}

model Interaction {
  id            String           @id @default(uuid())
  userId        String
  destinationId String
  type          InteractionType
  value         Int?
  createdAt     DateTime         @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([destinationId])
}

model Trip {
  id           String    @id @default(uuid())
  userId       String
  title        String
  budgetTotal  Float?
  peopleCount  Int       @default(1)
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime  @default(now())

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinations TripDestination[]
  expenses     Expense[]
}

model TripDestination {
  tripId              String
  destinationId       String
  position            Int
  plannedDateStart    DateTime?
  plannedDateEnd      DateTime?
  accommodationName   String?
  accommodationPrice  Float?
  accommodationUrl    String?

  trip        Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@id([tripId, destinationId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserPreference {
  id         String   @id @default(uuid())
  userId     String
  categoryId String
  featureId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category FeatureCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  feature  Feature         @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
}

enum ExpenseCategory {
  TRANSPORT
  FOOD
  ACTIVITIES
  OTHER
}

model Expense {
  id          String          @id @default(uuid())
  tripId      String
  description String
  amount      Float
  category    ExpenseCategory @default(OTHER)
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}